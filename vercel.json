{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/v1",
      "destination": "/v1/index.html"
    },
    {
      "source": "/v1/:path*",
      "destination": "/v1/index.html"
    },
    {
      "source": "/v2",
      "destination": "/v2/index.html"
    },
    {
      "source": "/v2/:path*",
      "destination": "/v2/index.html"
    },
    {
      "source": "/v3",
      "destination": "/v3/index.html"
    },
    {
      "source": "/v3/:path*",
      "destination": "/v3/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
