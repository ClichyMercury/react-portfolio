{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/v1"
    },
    {
      "source": "/v2/:path*",
      "destination": "/v2"
    },
    {
      "source": "/v3/:path*",
      "destination": "/v3"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
