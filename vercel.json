{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/:v(v1|v2|v3)",
      "destination": "/:v/index.html"
    },
    {
      "source": "/:v(v1|v2|v3)/:path*",
      "destination": "/:v/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
